# Rust build output (backend/target; it also holds the parity harness's Python-release environments and caches)
backend/target/
# Python virtualenvs and caches (the parity generators and deploy/turnstone-deliver.py are the only Python left)
.venv/
__pycache__/
*.pyc
node_modules/

# state, secrets and data that must never be committed
*.db
*.db-shm
*.db-wal
*.key
*.env
.env
# the content repo is its own git repository (HUB_CONTENT_DIR); an in-tree copy must never be committed here
content/
# generated delivery stage trees (rebuilt by hubctl apply)
out/
# knowledge service local data
*.lance/
# ... except the small Lance table the Python knowledge service wrote, kept as a compatibility fixture
!backend/crates/agent-knowledge/tests/fixtures/**/*.lance/

