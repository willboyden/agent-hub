# Agent Hub env file (template). Install it as ~/.config/agent-hub/env (or the path in AGENT_HUB_ENV_FILE), mode 0600:
#   install -D -m 600 agent-hub.env ~/.config/agent-hub/env
# The hub reads it once at start (restart the hub after a change); the real environment wins over this file.
# Syntax: plain KEY=value lines (python-dotenv; the systemd unit reads the same file through EnvironmentFile=, so no
# `export`). The few lines that are set below hold the built-in defaults, so the file as shipped changes nothing;
# the commented ones are optional: uncomment what you need. Lists are JSON. Reference: docs/OPERATIONS.md section 3.

# Where the hub listens. Keep loopback; the port also feeds the Host allowlist.
HUB_HOST=127.0.0.1
HUB_PORT=8792

# State and content. Defaults: ~/.local/share/agent-hub and ~/.local/share/agent-hub/content.
# HUB_DATA_DIR=/path/to/state
# HUB_CONTENT_DIR=/path/to/content

# Extra Host header values (JSON list), e.g. behind an authenticating reverse proxy.
HUB_ALLOWED_HOSTS=[]

# Leave this off: on, every local process is admin without a key (docs/SECURITY.md section 4).
HUB_TRUST_LOOPBACK=false

# The knowledge service. Its admin key is read from ~/.local/share/agent-knowledge/admin.key unless you set
# HUB_KNOWLEDGE_ADMIN_KEY here (a secret: keep this file 0600).
HUB_KNOWLEDGE_URL=http://127.0.0.1:8795
# KNOWLEDGE_ADMIN_KEY_FILE=/path/to/admin.key

# Limits also editable in Settings > General (a value saved there overrides this one).
# HUB_PLAN_RETENTION=20
# HUB_INBOX_MAX_PER_CLIENT=200
# HUB_INBOX_RATE_PER_MIN=20

# Request limits.
# HUB_BODY_CAP_BYTES=1048576
# HUB_IMPORT_BODY_CAP_BYTES=4194304
# HUB_MAX_SSE_CONNECTIONS=8
# HUB_SSE_IDLE_TIMEOUT_S=300

# Extra roots that discover and verify may read besides client roots (JSON list).
# HUB_DISCOVER_EXTRA_ROOTS=[]

# Prometheus metrics at /metrics (needs a key).
HUB_ENABLE_METRICS=true
